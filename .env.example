# ===== Telegram =====
# BotFather에서 발급
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 허용된 Telegram 사용자 ID (쉼표 구분). 비어 있으면 아무도 사용 못 함 (fail-closed)
ALLOWED_USER_IDS=123456789

# ===== Google (Drive / Calendar / Gmail) =====
# OAuth 2.0 클라이언트 자격증명 파일 (Google Cloud Console에서 다운로드)
GOOGLE_CREDENTIALS_FILE=credentials.json
# 인증 토큰 저장 경로 (PC에서 python auth_local.py 로 생성)
GOOGLE_TOKEN_FILE=data/token.json
# Railway 등 서버 배포용: 두 파일을 base64로 인코딩해 넣으면 시작 시 복원됨
# (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('data/token.json')))
GOOGLE_CREDENTIALS_B64=
GOOGLE_TOKEN_B64=

# ===== 저장소 =====
# SQLite 경로. Railway는 Volume을 /data에 마운트하고 /data/gs_secretary.db 로 (없으면 재배포 시 DB 소실)
DATABASE_PATH=data/gs_secretary.db
# 매일 03:00 DB 스냅샷을 올릴 Google Drive 폴더명 (빈 값이면 백업 안 함)
DB_BACKUP_DRIVE_FOLDER=GS-Secretary 백업

# ===== Claude API (Anthropic) =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 무거운 작업용 모델 (문서 검색·작성 등)
CLAUDE_MODEL=claude-sonnet-5
# 일반 대화용 경량 모델
CLAUDE_LIGHT_MODEL=claude-haiku-4-5
# Sonnet 5 adaptive thinking 강도 (low/medium/high). 채팅은 low, 무거운 작업은 medium 권장
CLAUDE_EFFORT=low
CLAUDE_HEAVY_EFFORT=medium
# thinking 토큰 포함 최대 출력
CLAUDE_MAX_TOKENS=8192
# CLAUDE_SYSTEM_PROMPT= (비워두면 카리나 기본 페르소나 사용 — 값을 넣으면 페르소나가 통째로 교체됨)

# ===== Gemini (웹 검색·음성 인식·증시 브리핑 검색) =====
# aistudio.google.com 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ===== OpenAI (선택, 음성 인식 Whisper 폴백) =====
OPENAI_API_KEY=

# ===== DART 전자공시 (opendart.fss.or.kr 무료 발급) =====
DART_API_KEY=your_dart_api_key_here
# 정기보고서 등 낮은 등급 공시를 묶어 보내는 시각 (KST)
DART_DIGEST_TIME=08:00
# 포트폴리오 국내 종목 장중 가격 변동 알림 임계값 (%). 0이면 끔
PRICE_ALERT_THRESHOLD_PCT=3.0

# ===== 알림 =====
# 일일 API 비용 한도 (USD) - 초과 시 텔레그램 알림
DAILY_COST_LIMIT_USD=1.0
# 조용시간 (KST). 이 시간대에는 긴급 아닌 알림을 미룸
QUIET_HOURS_START=22
QUIET_HOURS_END=7
# 미팅 준비 브리핑: 참석자/설명이 있는 일정 N분 전에 관련 메일·문서·메모 요약. 0이면 끔
MEETING_PREP_MINUTES=30

# ===== 아침 종목 리포트 =====
# '이름:코드' 쉼표 구분. 6자리 숫자면 국내 종목, 그 외는 해외 티커
STOCK_WATCHLIST=삼성전자:005930,SK하이닉스:000660,현대차:005380,구글:GOOGL
# 발송 시각 (KST, 평일)
STOCK_REPORT_TIME=07:20
# off: 서버 자동 발송 끔 (PC의 scripts/local_stock_report.py로 대체) / api: Claude API로 검토 후 발송 / digest: 목록만 발송
STOCK_REPORT_MODE=off
# 로컬 스크립트가 텔레그램 대신 Gmail로 보낼 주소 (선택)
STOCK_REPORT_EMAIL_TO=
# 증권사 리포트 원문 PDF 저장 여부 / 업로드할 Drive 폴더명 (빈 값이면 Drive 업로드 안 함)
STOCK_REPORT_SAVE_PDF=true
STOCK_REPORT_DRIVE_FOLDER=증권사리포트

# ===== 실행 =====
# all (전체), cloud (Drive+메모+리마인더), local (PC 파일만)
RUN_MODE=all
# 로컬 PC에서 접근 허용할 디렉토리 (쉼표 구분)
ALLOWED_PATHS=/home/user/Documents,/home/user/Downloads
# 텔레그램에서 받은 파일 임시 저장 경로
TEMP_DOWNLOAD_PATH=data/temp
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
