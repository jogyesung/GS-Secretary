# Telegram Bot Token (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 허용된 Telegram 사용자 ID (쉼표로 구분)
ALLOWED_USER_IDS=123456789,987654321

# Google OAuth 2.0 클라이언트 자격증명 파일 경로
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google OAuth 토큰 저장 경로
GOOGLE_TOKEN_FILE=data/token.json

# 로컬 PC에서 접근 허용할 디렉토리 (쉼표로 구분)
ALLOWED_PATHS=/home/user/Documents,/home/user/Downloads

# SQLite 데이터베이스 경로
DATABASE_PATH=data/gs_secretary.db

# Claude API (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_SYSTEM_PROMPT=당신은 GS Secretary라는 텔레그램 업무 비서입니다. 한국어로 친절하고 간결하게 답변하세요.
CLAUDE_MAX_TOKENS=4096

# Gemini API (실시간 웹 검색용, aistudio.google.com에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# DART 전자공시 API (opendart.fss.or.kr에서 무료 발급) - 포트폴리오 공시 알림용
DART_API_KEY=your_dart_api_key_here

# 아침 종목 리포트 워치리스트 ('이름:코드' 쉼표 구분, 6자리 숫자=국내 종목코드, 그 외=해외 티커)
STOCK_WATCHLIST=삼성전자:005930,SK하이닉스:000660,현대차:005380,구글:GOOGL

# 아침 종목 리포트 발송 시각 (KST, HH:MM, 평일만 발송)
STOCK_REPORT_TIME=07:20

# 아침 종목 리포트 모드: api (Claude API 상세검토, 비용 발생) / digest (수집 목록만, 무료)
# / off (서버 발송 끔 - PC에서 scripts/local_stock_report.py로 무료 실행할 때)
STOCK_REPORT_MODE=api

# 일일 API 비용 한도 (USD) - 초과 시 텔레그램 알림
DAILY_COST_LIMIT_USD=1.0

# 실행 모드: all (전체), cloud (Drive+메모+리마인더), local (PC파일만)
RUN_MODE=all

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 텔레그램에서 받은 파일 임시 저장 경로
TEMP_DOWNLOAD_PATH=data/temp
