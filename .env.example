# Telegram Bot Token (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 허용된 Telegram 사용자 ID (쉼표로 구분)
ALLOWED_USER_IDS=123456789,987654321

# Google OAuth 2.0 클라이언트 자격증명 파일 경로
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google OAuth 토큰 저장 경로
GOOGLE_TOKEN_FILE=data/token.json

# 로컬 PC에서 접근 허용할 디렉토리 (쉼표로 구분)
ALLOWED_PATHS=/home/user/Documents,/home/user/Downloads

# SQLite 데이터베이스 경로
DATABASE_PATH=data/gs_secretary.db

# Claude API (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_SYSTEM_PROMPT=당신은 GS Secretary라는 텔레그램 업무 비서입니다. 한국어로 친절하고 간결하게 답변하세요.
CLAUDE_MAX_TOKENS=4096

# 실행 모드: all (전체), cloud (Drive+메모+리마인더), local (PC파일만)
RUN_MODE=all

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 텔레그램에서 받은 파일 임시 저장 경로
TEMP_DOWNLOAD_PATH=data/temp
